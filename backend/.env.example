# Bu dosyayı .env olarak kopyalayıp gerçek değerlerinizi girin.
# .env asla git'e commit edilmez (bkz. .gitignore).

# --- Binance canlı işlem ---
# Binance hesabınızdan API Management üzerinden oluşturun.
# Sadece gerekli izinleri verin (Futures/Spot trading); withdrawal iznini ASLA açmayın.
FOURKEYS_BINANCE_API_KEY=
FOURKEYS_BINANCE_API_SECRET=
# true = testnet.binancefuture.com / testnet.binance.vision (gerçek para riske girmez, önerilir)
# false = GERÇEK hesap, GERÇEK para
FOURKEYS_BINANCE_TESTNET=true
# İkinci güvenlik kapısı: bu true olmadan /trading/order gerçek emir göndermez,
# hatta testnet dışı gerçek hesapta hiç göndermez.
FOURKEYS_ENABLE_LIVE_TRADING=false

# --- Denizbank Açık Bankacılık (bakiye görüntüleme) ---
# Denizbank'ın TPP/fintech geliştirici portalından (Açık Bankacılık başvurusu
# sonrası) alınan değerlerle doldurulmalı. Şu an burada yer alan alan adları
# ve uç noktalar Türkiye Açık Bankacılık standardının GENEL kalıbını izler —
# Denizbank'a özgü kesin uç nokta yollarını geliştirici portalından teyit edin.
FOURKEYS_DENIZBANK_BASE_URL=
FOURKEYS_DENIZBANK_CLIENT_ID=
FOURKEYS_DENIZBANK_CLIENT_SECRET=
FOURKEYS_DENIZBANK_REDIRECT_URI=http://localhost:8000/bank/denizbank/callback

# --- Kalıcı veritabanı (opsiyonel) ---
# Boş bırakılırsa devre dışıdır, sistem bellek içi çalışır. docker-compose ile
# çalıştırırken bu değer otomatik ayarlanır, elle doldurmanıza gerek yok.
FOURKEYS_DATABASE_URL=

